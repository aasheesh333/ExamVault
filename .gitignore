# Local scratch
/tmp/
*.log
.DS_Store

# web build output. NOTE: app/web/ itself is handcrafted SOURCE (boot splash in
# index.html, branded manifest.json, icons/, favicon) and must stay tracked —
# `flutter build web` writes to app/build/, never into app/web/.
app/build/

# generated roll indexes (built from official PDFs, published to R2)
/build/

# python bytecode
__pycache__/
*.pyc

# SDD scratch workspace (git-ignored)
.superpowers/

# Generated policy site (tools/site/build_policy_pages.py; deployed by pages.yml)
site/
