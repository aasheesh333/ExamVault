<?xml version="1.0" encoding="utf-8"?>
<!--
    Adaptive launcher icon (Android 8.0+).

    Without this file the launcher falls back to the legacy PNG and applies its
    own mask, which crops the shield's point on Pixel/Nova-shaped icons. An
    adaptive icon declares the layers explicitly so the mark stays inside the
    66dp safe zone regardless of the mask the OEM uses.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ev_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <!-- Themed icons (Android 13+): monochrome tint of the same mark. -->
    <monochrome android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
