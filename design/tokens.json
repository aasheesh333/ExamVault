{
  "$schema": "https://design-tokens.org/schema.json",
  "meta": {
    "name": "ExamVault",
    "version": "1.0.0",
    "theme": "Deep Navy",
    "frame": {
      "width": 393,
      "height": 852,
      "grid": 8
    },
    "fonts": {
      "ui": "Plus Jakarta Sans",
      "mono": "IBM Plex Mono"
    },
    "themes": [
      "deep-navy (dark)",
      "crisp-alabaster (light)"
    ]
  },
  "color": {
    "bg": {
      "primary": "#0B0F19",
      "alabaster": "#F8FAFC",
      "sunken": "#0E1522",
      "board": "#05070C"
    },
    "surface": {
      "card": "#111827",
      "elevated": "#0F1624",
      "overlay": "rgba(17, 24, 39, 0.82)"
    },
    "border": {
      "default": "#1F2937",
      "strong": "#263246",
      "wallet": "#28374F",
      "hairline": "rgba(255, 255, 255, 0.05)"
    },
    "accent": {
      "primary": "#3B82F6",
      "bright": "#60A5FA",
      "deep": "#2563EB",
      "soft": "rgba(59, 130, 246, 0.14)",
      "text": "#93C5FD"
    },
    "status": {
      "success": "#10B981",
      "successText": "#6EE7B7",
      "warning": "#F59E0B",
      "warningText": "#FCD34D",
      "danger": "#EF4444",
      "dangerText": "#FCA5A5"
    },
    "text": {
      "primary": "#F9FAFB",
      "secondary": "#9CA3AF",
      "tertiary": "#6B7280",
      "inverse": "#0B0F19",
      "inverseSecondary": "#475569"
    },
    "gradients": {
      "walletFront": [
        "#1E2C46",
        "#172136",
        "#121A29"
      ],
      "walletMiddle": [
        "#1A2438",
        "#131C2C",
        "#0F1624"
      ],
      "walletBack": [
        "#1C2433",
        "#141B28",
        "#101723"
      ],
      "primaryButton": [
        "#4E90F9",
        "#2F74E8",
        "#2563EB"
      ],
      "whatsappButton": [
        "#31E07A",
        "#1FBE63"
      ],
      "alert": [
        "#F05252",
        "#DC2626"
      ]
    },
    "light": {
      "bg": {
        "primary": "#F6F8FB",
        "card": "#FFFFFF",
        "sunken": "#F1F5F9"
      },
      "border": {
        "default": "#E2E8F0",
        "strong": "#CBD5E1",
        "wallet": "#C7D8EA"
      },
      "text": {
        "primary": "#0F172A",
        "secondary": "#475569",
        "tertiary": "#5B6B80"
      },
      "accent": {
        "text": "#1D4ED8"
      },
      "status": {
        "success": "#047857",
        "successDot": "#059669",
        "warning": "#B45309",
        "danger": "#B91C1C"
      }
    }
  },
  "typography": {
    "ui": {
      "hero": {
        "family": "Plus Jakarta Sans",
        "size": 26.5,
        "weight": 700,
        "lineHeight": 1.12,
        "letterSpacing": -0.7
      },
      "screenTitle": {
        "family": "Plus Jakarta Sans",
        "size": 23.5,
        "weight": 700,
        "lineHeight": 1.2,
        "letterSpacing": -0.5
      },
      "cardTitle": {
        "family": "Plus Jakarta Sans",
        "size": 17,
        "weight": 700,
        "lineHeight": 1.25,
        "letterSpacing": -0.25
      },
      "sectionTitle": {
        "family": "Plus Jakarta Sans",
        "size": 11.5,
        "weight": 600,
        "lineHeight": 1.3,
        "letterSpacing": 0
      },
      "body": {
        "family": "Plus Jakarta Sans",
        "size": 11.5,
        "weight": 500,
        "lineHeight": 1.45,
        "letterSpacing": 0
      },
      "label": {
        "family": "Plus Jakarta Sans",
        "size": 10.5,
        "weight": 600,
        "lineHeight": 1.3
      },
      "button": {
        "family": "Plus Jakarta Sans",
        "size": 12.5,
        "weight": 700,
        "lineHeight": 1.2
      },
      "micro": {
        "family": "Plus Jakarta Sans",
        "size": 8.5,
        "weight": 600,
        "lineHeight": 1.3
      }
    },
    "mono": {
      "rollHero": {
        "family": "IBM Plex Mono",
        "size": 31,
        "weight": 500,
        "letterSpacing": 1.6
      },
      "rollCard": {
        "family": "IBM Plex Mono",
        "size": 23,
        "weight": 500,
        "letterSpacing": 1.2
      },
      "value": {
        "family": "IBM Plex Mono",
        "size": 11.5,
        "weight": 500,
        "letterSpacing": 0.2
      },
      "meta": {
        "family": "IBM Plex Mono",
        "size": 9.5,
        "weight": 400,
        "letterSpacing": 0.55
      },
      "label": {
        "family": "IBM Plex Mono",
        "size": 8.5,
        "weight": 500,
        "letterSpacing": 1.25
      },
      "eyebrow": {
        "family": "IBM Plex Mono",
        "size": 9,
        "weight": 400,
        "letterSpacing": 1.7
      },
      "pill": {
        "family": "IBM Plex Mono",
        "size": 7.5,
        "weight": 600,
        "letterSpacing": 0.9
      }
    }
  },
  "spacing": {
    "unit": 8,
    "screenPadding": 16,
    "sectionGap": 17,
    "cardPadding": 16,
    "rowGap": 8,
    "stack": {
      "backInset3": 20,
      "backInset2": 10,
      "backY3": 0,
      "backY2": 40,
      "frontY": 88
    }
  },
  "radius": {
    "card": 20,
    "innerCard": 16,
    "button": 14,
    "input": 14,
    "iconButton": 11,
    "chip": 999,
    "pill": 6,
    "notch": 8
  },
  "sizing": {
    "walletCard": {
      "width": 361,
      "height": 176,
      "stackHeight": 264
    },
    "buttonHeight": 52,
    "secondaryButtonHeight": 44,
    "chipHeight": 30,
    "navBar": 40,
    "tabBar": {
      "height": 58,
      "bottom": 24,
      "radius": 19
    },
    "copyPill": 31,
    "tapTargetMin": 44
  },
  "elevation": {
    "walletCard": "inset 0 1px 0 rgba(255,255,255,0.15), 0 18px 40px -22px rgba(0,0,0,0.90)",
    "primaryButton": "0 12px 26px -12px rgba(59,130,246,0.95), inset 0 1px 0 rgba(255,255,255,0.32)",
    "floatNav": "0 18px 40px -16px rgba(0,0,0,0.95), inset 0 1px 0 rgba(255,255,255,0.07)",
    "statusGlow": "0 0 16px -6px currentColor"
  },
  "motion": {
    "copyConfirm": {
      "durationMs": 180,
      "curve": "easeOut"
    },
    "livePulse": {
      "durationMs": 2200,
      "curve": "easeInOut",
      "loop": true
    },
    "caretBlink": {
      "durationMs": 1100,
      "curve": "step-end",
      "loop": true
    }
  },
  "components": {
    "walletCard": {
      "radius": 20,
      "border": "1px solid #28374F",
      "innerTopHighlight": "rgba(255,255,255,0.15)",
      "sheen": "linear-gradient(112deg, transparent 34%, rgba(255,255,255,0.07) 46%, transparent 58%)"
    },
    "statusPill": {
      "height": 19,
      "radius": 6,
      "dot": 4.5,
      "font": "IBM Plex Mono 7.5/600 +0.9",
      "glow": "0 0 16px -6px currentColor"
    },
    "copyPill": {
      "height": 31,
      "radius": 999,
      "icon": 12,
      "font": "Plus Jakarta Sans 10/700",
      "background": "linear-gradient(180deg, #4C8DF7, #2563EB)"
    },
    "passPerforation": {
      "line": "1px dashed rgba(255,255,255,0.15)",
      "notchDiameter": 16,
      "notchFill": "#0B0F19"
    },
    "walletCardLight": {
      "note": "The pass/wallet cards stay deep navy in BOTH themes \u2014 they read as physical objects (Apple Wallet), and it keeps roll-number contrast at 13.96:1.",
      "shell": "unchanged from dark"
    }
  }
}